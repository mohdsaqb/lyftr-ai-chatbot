# Backend only. Replace both placeholders in your private .env file.
LLM_API_KEYS=replace_with_first_groq_key,replace_with_second_groq_key
GROQ_MODEL_1=groq/openai/gpt-oss-20b
GROQ_MODEL_2=groq/openai/gpt-oss-120b
DATABASE_URL=sqlite:////data/app.db
ENABLE_FAILURE_SIMULATION=true

# Local ports. The Render Blueprint sets PORT to the backend image's port.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# On Render, use the exact Vercel production origin (scheme and host).
ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT}
# On Vercel, use the Render web service URL. This value is public.
VITE_API_BASE_URL=http://localhost:${BACKEND_PORT}
